package com.infosoft.sira.catalogo;
import org.springframework.jdbc.core.JdbcTemplate;import org.springframework.web.bind.annotation.*;import java.util.*;
@RestController @RequestMapping("/api/v1/catalogos-v4")
public class CatalogoV4Controller{private final JdbcTemplate db;public CatalogoV4Controller(JdbcTemplate db){this.db=db;}
@GetMapping("/nacionalidades") public List<Map<String,Object>> nacionalidades(){return db.queryForList("select id_nacionalidad_catalogo,codigo,descripcion from sira.cat_nacionalidad where activo='S' order by case when codigo='VE' then 0 else 1 end,descripcion");}
@GetMapping("/niveles") public List<Map<String,Object>> niveles(){return db.queryForList("select id_nivel,descripcion from sira.cat_nivel_educativo where activo='S' order by id_nivel");}
@GetMapping("/especialidades") public List<Map<String,Object>> especialidades(){return db.queryForList("select id_especialidad,descripcion from sira.cat_especialidad where activo='S' order by descripcion");}
@GetMapping("/honores") public List<Map<String,Object>> honores(){return db.queryForList("select id_honor,descripcion from sira.cat_honor_academico where activo='S' order by descripcion");}
@GetMapping("/modalidades") public List<Map<String,Object>> modalidades(){return db.queryForList("select id_modalidad,descripcion from sira.cat_modalidad where activo='S' order by descripcion");}
@GetMapping("/disponibilidades") public List<Map<String,Object>> disponibilidades(){return db.queryForList("select id_disponibilidad,descripcion from sira.cat_disponibilidad where activo='S' order by descripcion");}}
