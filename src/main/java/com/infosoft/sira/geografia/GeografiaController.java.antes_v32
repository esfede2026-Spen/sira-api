package com.infosoft.sira.geografia;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.web.bind.annotation.*;
import java.util.*;

@RestController
@RequestMapping("/api/v1/geografia")
public class GeografiaController {
 private final JdbcTemplate db;
 public GeografiaController(JdbcTemplate db){this.db=db;}
 @GetMapping("/paises") public List<Map<String,Object>> paises(){return db.queryForList("select id_pais,codigo_iso2,desc_pais from sira.pais where activo='S' order by desc_pais");}
 @GetMapping("/estados") public List<Map<String,Object>> estados(@RequestParam long paisId){return db.queryForList("select id_estado,desc_estado from sira.estado where activo='S' and id_pais=? order by desc_estado",paisId);}
 @GetMapping("/ciudades") public List<Map<String,Object>> ciudades(@RequestParam long estadoId){return db.queryForList("select id_ciudad,desc_ciudad from sira.ciudad where activo='S' and id_estado=? order by desc_ciudad",estadoId);}
 @GetMapping("/municipios") public List<Map<String,Object>> municipios(@RequestParam long ciudadId){return db.queryForList("select id_municipio,desc_municipio from sira.municipio where activo='S' and id_ciudad=? order by desc_municipio",ciudadId);}
 @GetMapping("/parroquias") public List<Map<String,Object>> parroquias(@RequestParam long municipioId){return db.queryForList("select id_parroquia,desc_parroquia from sira.parroquia where activo='S' and id_municipio=? order by desc_parroquia",municipioId);}
 @GetMapping("/sectores") public List<Map<String,Object>> sectores(@RequestParam long parroquiaId){return db.queryForList("select id_sector_geografico,desc_sector_geografico from sira.sector_geografico where activo='S' and id_parroquia=? order by desc_sector_geografico",parroquiaId);}
 @GetMapping("/codigos-postales") public List<Map<String,Object>> cp(@RequestParam long sectorId){return db.queryForList("select id_codigo_postal,codigo_postal from sira.codigo_postal where activo='S' and id_sector_geografico=? order by codigo_postal",sectorId);}
 @GetMapping("/codigos-telefonicos") public List<Map<String,Object>> codigos(){return db.queryForList("select id_codigo_telefonico,codigo_pais,codigo_area_operador,descripcion,tipo_linea from sira.cat_codigo_telefonico where activo='S' order by tipo_linea,codigo_area_operador");}
 @GetMapping("/tipos-contacto") public List<Map<String,Object>> tipos(){return db.queryForList("select id_tipo_contacto,codigo,descripcion,permite_otp from sira.cat_tipo_contacto where activo='S' order by id_tipo_contacto");}
 @GetMapping("/sexos") public List<Map<String,Object>> sexos(){return db.queryForList("select id_sexo,codigo,descripcion from sira.cat_sexo where activo='S' order by descripcion");}
}
